# Secrets
.env
.env.*
!.env.example

# Audio — the supplied episodes are not ours to redistribute.
# Fixture scripts under scripts/fixtures/ ARE committed so the synthetic
# development audio is reproducible with `make fixtures`.
audio/*
!audio/README.md

# Generated pipeline artefacts.
#
# data/index, data/chunks and data/manifest.json ARE committed: they are the
# only things the *server* needs at runtime (~3.5 MB), so committing them lets
# a container be built straight from this repo with no ASR step. Everything
# else is a large, purely intermediate by-product of `make ingest`.
data/transcripts/
data/normalized/

# Evaluation runs: the baseline and improved runs are committed as evidence;
# ad-hoc timestamped runs are not.
eval/results/run_2*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Models / caches
.cache/
*.pt
*.bin
# ...but Chroma stores its HNSW vectors as .bin inside the committed index,
# and excluding them would ship a silently broken index.
!data/index/**/*.bin

# Local CLI caches (wrangler stores the Cloudflare account id/email here)
.wrangler/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
