# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env
#
# Only ONE key is required: whichever provider CHAT_PROVIDER names.
# Everything else (ASR, embeddings, reranking, vector DB) runs locally for free.

# ---- chat -------------------------------------------------------------
# openrouter | anthropic | openai
CHAT_PROVIDER=openrouter
# OpenRouter model ids are namespaced "vendor/model".
# Run `make models` to list what your key can reach.
CHAT_MODEL=anthropic/claude-sonnet-5
CHAT_MAX_TOKENS=8000
CHAT_EFFORT=medium               # low | medium | high | xhigh | max
REWRITE_EFFORT=low               # follow-up query rewriting is a cheap call

# ---- credentials ------------------------------------------------------
# Only the key matching CHAT_PROVIDER / JUDGE_PROVIDER is needed.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- OpenRouter specifics ---------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on openrouter.ai rankings.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Fermi Podcast Companion
# Only reasoning-capable models accept a reasoning effort. Leave false unless
# CHAT_MODEL is a reasoning model, or the request may be rejected.
OPENROUTER_SEND_REASONING=false

# ---- evaluation judge -------------------------------------------------
# Deliberately a different vendor from CHAT_MODEL: a judge grading its own
# family's output is prone to self-preference bias. Same key, so this costs
# nothing extra to arrange.
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=openai/gpt-5-mini
JUDGE_EFFORT=medium
JUDGE_MAX_TOKENS=4000

# ---- ASR (local by default, no key, no cost) --------------------------
ASR_PROVIDER=local               # local | openai
ASR_MODEL=medium                 # large-v3 | medium | small | base | tiny
                                 # falls back automatically if it cannot load
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=en

# ---- embeddings (local by default) ------------------------------------
EMBED_PROVIDER=local             # local | openai
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- chunking ---------------------------------------------------------
CHUNK_TARGET_SECONDS=75
CHUNK_MAX_SECONDS=110
CHUNK_OVERLAP_SECONDS=15

# ---- retrieval --------------------------------------------------------
RETRIEVAL_MODE=hybrid            # hybrid | dense   (dense = the eval baseline)
TOP_K=5
DENSE_K=20
BM25_K=20
FUSION_K=8
RRF_K=60

# ---- reranking and the refusal gate -----------------------------------
ENABLE_RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Left blank, the gate calibrated during `make ingest` is used.
# Set it to override (higher = refuses more readily).
RERANK_GATE_OVERRIDE=
MIN_RELEVANCE=0.30               # bi-encoder fallback when reranking is off

# ---- behaviour flags --------------------------------------------------
ENABLE_QUERY_REWRITE=true
ENABLE_COMPARE_MODE=true

# ---- paths and logging ------------------------------------------------
VECTOR_DB_PATH=data/index
LOG_LEVEL=INFO

# --- episode audio delivery -------------------------------------------------
# local: read MP3s from audio/ (the default; how it runs on a dev machine).
# s3:    stream from private S3-compatible storage (Cloudflare R2) so a public
#        deployment can play audio without redistributing the MP3s. HTTP Range
#        is forwarded to the store, so seeking to a citation still works.
AUDIO_BACKEND=local
AUDIO_S3_BUCKET=
AUDIO_S3_ENDPOINT=
AUDIO_S3_REGION=auto
# R2 API token credentials (Object Read only). Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
